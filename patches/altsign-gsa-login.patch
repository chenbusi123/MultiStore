+private extension ALTAppleAPI {
+    func parsePlistOrJSON(_ data: Data) -> [String: Any]? {
+        (try? PropertyListSerialization.propertyList(from: data, format: nil)) as? [String: Any]
+            ?? (try? JSONSerialization.jsonObject(with: data, options: [])) as? [String: Any]
+    }
+
+    func authenticationResponseError(statusCode: Int?, contentType: String?, byteCount: Int, reason: String) -> NSError {
+        let status = statusCode.map { String($0) } ?? "unknown"
+        return NSError(
+            domain: "AltSign.AuthenticationResponse",
+            code: statusCode ?? URLError.badServerResponse.rawValue,
+            userInfo: [
+                NSLocalizedDescriptionKey: "Apple login server returned an unexpected response (HTTP \(status)). Please try again.",
+                NSLocalizedFailureReasonErrorKey: reason,
+                "ALTResponseContentType": contentType ?? "missing",
+                "ALTResponseByteCount": byteCount
+            ]
+        )
+    }
+}
